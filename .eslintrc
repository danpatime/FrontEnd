{
    "extends": ["eslint:recommended", "prettier"],
    "env": { "browser": true, "node": true, "es6": true },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      },
      "ecmaVersion": "latest"
    },
    "rules": {
      "no-console": ["error", { "allow": ["warn", "error", "info"] }], // console.log() 금지
      "no-unused-vars": "error" // 사용하지 않는 변수 금지
    }
  }